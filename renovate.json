{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>LedgerHQ/renovate-config:base.json5",
    "github>LedgerHQ/renovate-config//infra/gha.json5"
  ],
  "packageRules": [
    {
      "description": "Hold npm updates whose release date Renovate cannot read, so the seven-day minimum release age applies",
      "matchDatasources": ["npm"],
      "minimumReleaseAgeBehaviour": "timestamp-required"
    }
  ]
}
